			"metadata": "Secure string for 'accountKey' of 'Datalake'"
		},
		"ADLSGen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageeo5bnndkb2dhu.dfs.core.windows.net/"
		},
		"AzureSqlDW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "myserver132.database.windows.net"
		},
		"AzureSqlDW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "mydatabase105"
		},
		"Datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccntdl.dfs.core.windows.net/"
		}
	},
	"variables": {
