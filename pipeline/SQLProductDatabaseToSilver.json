{
	"name": "SQLProductDatabaseToSilver",
	"properties": {
		"activities": [
			{
				"name": "Copy to SQL",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"wildcardFolderPath": "Bronze/ProductDatabase",
							"wildcardFileName": "*.parquet",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "drop table if exists  Stage.SalesOrderTemp\ncreate table Stage.SalesOrderTemp\n(\n    OrderID varchar(max),\n    Product varchar(max),\n    QuantityOrdered varchar(max),\n    PriceEach varchar(max),\n    OrderDate varchar(max),\n    PurchaseAddress varchar(max),\n    FileName varchar(max),\n    LoadDate varchar(max)\n)",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": true,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureDataLakeParquet",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": "Bronze/ProductDatabase"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AzureSqlDatabaseTable",
						"type": "DatasetReference",
						"parameters": {
							"Schema": "Stage",
							"TableName": "SalesOrderTemp"
						}
					}
				]
			},
			{
				"name": "SalesOrderLoad",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy to SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[Stage].[SalesOrderLoad]"
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDW",
					"type": "LinkedServiceReference"
				}
			}
		],
		"folder": {
			"name": "SQL"
		},
		"annotations": []
	}
}